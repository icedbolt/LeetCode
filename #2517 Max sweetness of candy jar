# Python

# brute force

def maximumTastiness(self, price: list[int], k: int) -> int:
    price = sorted(price)
    best = 0
    for basket in combinations(price, k):  # Every combination of k candies
        tasty = float('inf')
        for i in range(k-1):
            tasty = min(tasty, basket[i+1] - basket[i])   # smallest difference always b/w neighbours
        best = max(best, tasty)
    return best

# Time: O(C(n, k) · k), which grows exponentially with n. It's only usable for small inputs (about n ≤ 20).

