# Binary Search: T = O(nlogn)

def findRightInterval(self, intervals: list[list[int]]) -> list[int]:
    n = len(intervals)
    starts = sorted((intervals[i][0], i) for i in range(n)) # store each interval start point and original index 

    ans = []
    for start, end in intervals:
        l, r = 0, n - 1
        result = -1
        while l <= r:
            mid = (l + r)//2
            
            if starts[mid][0] >= end:
                result = starts[mid][1]
                r = mid - 1
            else:
                l = mid + 1
        ans.append(result)
    return ans
